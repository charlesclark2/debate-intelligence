{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "debate-research verify --json output",
  "description": "One JSON object on stdout per run. Exit 0: every card VERIFIED, report under data. Exit 1: some card UNVERIFIED, report under error.details. Exit 2: usage error, a manifest that fails its schema, with the failing JSON path, or a .docx with no embedded manifest (NO_MANIFEST). Exit 3: verification could not run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "command",
    "data",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": true,
    "error": true
  },
  "oneOf": [
    {
      "title": "Every card VERIFIED (exit 0)",
      "properties": {
        "status": {
          "const": "ok"
        },
        "data": {
          "$ref": "#/$defs/ManifestVerificationReport"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "title": "Some card UNVERIFIED (exit 1)",
      "properties": {
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "exit_code",
            "details",
            "hint"
          ],
          "properties": {
            "code": {
              "const": "UNVERIFIED"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "const": 1
            },
            "details": {
              "$ref": "#/$defs/ManifestVerificationReport"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Not a manifest (exit 2)",
      "properties": {
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "exit_code",
            "details",
            "hint"
          ],
          "properties": {
            "code": {
              "const": "INVALID_MANIFEST"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "const": 2
            },
            "details": {
              "type": "object",
              "required": [
                "json_path",
                "problem",
                "violations",
                "manifest"
              ],
              "properties": {
                "json_path": {
                  "type": "string",
                  "pattern": "^\\$"
                },
                "problem": {
                  "type": "string"
                },
                "violations": {
                  "type": "integer",
                  "minimum": 1
                },
                "manifest": {
                  "type": "string"
                }
              }
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "title": "No manifest in the .docx (exit 2)",
      "properties": {
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "exit_code",
            "details",
            "hint"
          ],
          "properties": {
            "code": {
              "const": "NO_MANIFEST"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "const": 2
            },
            "details": {
              "type": "object",
              "required": [
                "document"
              ],
              "properties": {
                "document": {
                  "type": "string"
                }
              }
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Usage error (exit 2)",
      "properties": {
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "exit_code",
            "details",
            "hint"
          ],
          "properties": {
            "code": {
              "const": "USAGE_ERROR"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "const": 2
            },
            "details": {
              "type": "object"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "title": "Verification could not run (exit 3)",
      "properties": {
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "exit_code",
            "details",
            "hint"
          ],
          "properties": {
            "code": {
              "const": "VERIFICATION_COULD_NOT_RUN"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "const": 3
            },
            "details": {
              "type": "object",
              "required": [
                "card_id",
                "position",
                "cause"
              ],
              "properties": {
                "card_id": {
                  "type": "string"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "cause": {
                  "type": "string"
                }
              }
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "CardVerdict": {
      "additionalProperties": false,
      "description": "The verdict on one card of the manifest.",
      "properties": {
        "position": {
          "description": "The card's index in the manifest's cards.",
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "reasons": {
          "description": "Every reason found, in check order.",
          "items": {
            "$ref": "#/$defs/ReportedReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The snapshot the card names, if it names one.",
          "title": "Snapshot Id"
        },
        "checks_run": {
          "description": "The verifier's checks that ran. Empty for a card that was never a valid Card.",
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          },
          "title": "Checks Run",
          "type": "array"
        },
        "verifier_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The verifier's rules version; null when the card never reached the verifier.",
          "title": "Verifier Version"
        },
        "warnings": {
          "default": [],
          "description": "What a reader should know that changes no status, in body order. Absent when none.",
          "items": {
            "$ref": "#/$defs/ReportedWarning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "reason_codes": {
          "description": "The codes of :attr:`reasons`, in order, without repeats.",
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "readOnly": true,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "position",
        "card_id",
        "tag",
        "status",
        "reasons",
        "snapshot_id",
        "checks_run",
        "verifier_version",
        "reason_codes"
      ],
      "title": "CardVerdict",
      "type": "object"
    },
    "DocumentCheck": {
      "additionalProperties": false,
      "description": "What was read of a .docx's body beside its manifest (`v1-e06-t07`).",
      "properties": {
        "format_profile": {
          "description": "The format profile the body was read in: the one its cards name.",
          "title": "Format Profile",
          "type": "string"
        },
        "body_cards": {
          "description": "How many cards (tag paragraphs) the body holds.",
          "minimum": 0,
          "title": "Body Cards",
          "type": "integer"
        },
        "unclaimed_body_cards": {
          "description": "The positions, among the body's cards from 0, of those no manifest card claims, such as a card pasted in by hand. Each has an entry in unclaimed_body_card_verdicts.",
          "items": {
            "type": "integer"
          },
          "title": "Unclaimed Body Cards",
          "type": "array"
        },
        "unclaimed_body_card_verdicts": {
          "default": [],
          "description": "One UNVERIFIED entry per unclaimed body card, in body order, counted in the report's total and unverified. A manifest card's status does not change for them.",
          "items": {
            "$ref": "#/$defs/UnclaimedBodyCardVerdict"
          },
          "title": "Unclaimed Body Card Verdicts",
          "type": "array"
        }
      },
      "required": [
        "format_profile",
        "body_cards",
        "unclaimed_body_cards"
      ],
      "title": "DocumentCheck",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Why a card is UNVERIFIED. Values are stable: they are written into reports and JSON output.",
      "enum": [
        "SNAPSHOT_MISSING",
        "HASH_MISMATCH",
        "UNKNOWN_NORMALIZER_VERSION",
        "CARD_INCOMPLETE",
        "TEXT_MISMATCH",
        "SPAN_OUT_OF_RANGE",
        "CITATION_UNVERIFIED",
        "ARTICLE_MISMATCH",
        "PROVENANCE_MISMATCH",
        "CARD_INVALID",
        "SNAPSHOT_REFERENCE_MISMATCH",
        "MANUAL_EDIT",
        "BODY_CARD_MISSING",
        "BODY_CARD_NOT_IN_MANIFEST"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ReportedRange": {
      "additionalProperties": false,
      "description": "``[start, end)`` in characters; empty where something was only added.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ReportedRange",
      "type": "object"
    },
    "ReportedReason": {
      "additionalProperties": false,
      "description": "One reason a card is UNVERIFIED, as the report carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "detail": {
          "description": "For people. Gives offsets, lengths and record values; never evidence text.",
          "title": "Detail",
          "type": "string"
        },
        "first_differing_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For TEXT_MISMATCH only: the first index where the texts differ, in evidence_text.",
          "title": "First Differing Offset"
        },
        "evidence_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportedRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For MANUAL_EDIT only: the evidence_text range the body changed. Absent otherwise."
        },
        "body_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportedRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For MANUAL_EDIT only: the range of the body's evidence (its paragraphs joined with a line feed) that replaced it. Absent otherwise."
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "ReportedReason",
      "type": "object"
    },
    "ReportedWarning": {
      "additionalProperties": false,
      "description": "Something about a card a reader should know that leaves it VERIFIED (`v1-e06-t07`).",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "detail": {
          "description": "For people. Gives offsets and lengths; never evidence or inserted text.",
          "title": "Detail",
          "type": "string"
        },
        "evidence_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For INTERPOLATION_PRESENT: the evidence_text offset it is read before.",
          "title": "Evidence Offset"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "ReportedWarning",
      "type": "object"
    },
    "UnclaimedBodyCardVerdict": {
      "additionalProperties": false,
      "description": "The verdict on a card in a .docx's body that its manifest does not list (`v1-e06-t07`).\n\nAlways UNVERIFIED with ``BODY_CARD_NOT_IN_MANIFEST``: no snapshot is named for it, so nothing it\nshows can be verified. It has no card id; it is known by its position in the body.",
      "properties": {
        "body_position": {
          "description": "Its index among the body's cards, from 0.",
          "minimum": 0,
          "title": "Body Position",
          "type": "integer"
        },
        "tag": {
          "description": "Its tag as the body shows it.",
          "title": "Tag",
          "type": "string"
        },
        "status": {
          "const": "UNVERIFIED",
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ReportedReason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "reason_codes": {
          "description": "The codes of :attr:`reasons`, in order, without repeats.",
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "readOnly": true,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "body_position",
        "tag",
        "status",
        "reasons",
        "reason_codes"
      ],
      "title": "UnclaimedBodyCardVerdict",
      "type": "object"
    },
    "VerificationCheck": {
      "description": "One check the verifier can run. A result lists those that ran, passed or not.",
      "enum": [
        "card_complete",
        "normalizer_version_known",
        "citation_verified",
        "snapshot_integrity",
        "article_matches_snapshot",
        "provenance_matches_snapshot",
        "card_matches_snapshot",
        "evidence_reconstructed",
        "evidence_text_exact",
        "spans_inside_evidence"
      ],
      "title": "VerificationCheck",
      "type": "string"
    },
    "VerificationStatus": {
      "description": "Whether a card's quoted evidence has been reproduced from its stored snapshot.\n\n`VERIFIED` is set only by the evidence verifier (E03), only after the evidence text has been\nreconstructed byte for byte from the recorded snapshot offsets. Anything else is `UNVERIFIED`\nand must never be presented as a finished card.",
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "FAILED"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "WarningCode": {
      "description": "Something about a VERIFIED card a reader should know. Never a reason: the status stays VERIFIED.",
      "enum": [
        "INTERPOLATION_PRESENT"
      ],
      "title": "WarningCode",
      "type": "string"
    },
    "ManifestVerificationReport": {
      "additionalProperties": false,
      "description": "Every card of one manifest, with its verdict, in manifest order.",
      "properties": {
        "manifest_version": {
          "description": "The manifest's own manifest_version.",
          "enum": [
            1,
            2
          ],
          "title": "Manifest Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "The manifest's own generated_at.",
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/CardVerdict"
          },
          "title": "Cards",
          "type": "array"
        },
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a .docx: what was read of its body. Absent for a JSON manifest."
        },
        "total": {
          "description": "How many cards were judged: the manifest's, and for a .docx each body card it does not list.",
          "readOnly": true,
          "title": "Total",
          "type": "integer"
        },
        "verified": {
          "description": "How many of them are VERIFIED. A body card the manifest does not list never is.",
          "readOnly": true,
          "title": "Verified",
          "type": "integer"
        },
        "unverified": {
          "description": "How many of them are not.",
          "readOnly": true,
          "title": "Unverified",
          "type": "integer"
        }
      },
      "required": [
        "manifest_version",
        "generated_at",
        "cards",
        "total",
        "verified",
        "unverified"
      ],
      "title": "ManifestVerificationReport",
      "type": "object"
    }
  }
}
