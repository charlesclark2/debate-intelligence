# Local, uncommitted configuration for debate-research. Copy to `.env` and edit:
#
#     cp .env.example .env
#
# `.env` is gitignored; this example file is not. Never put a real key, token or address in the
# example — and never in `config/profiles/*.toml`, which are committed too.
#
# Precedence, highest first: a command-line flag > these variables exported in your shell >
# `.env` > `config/profiles/<env>.toml` > the built-in profile for the environment.
# `debate-research config show` prints the effective value of every setting and which of those
# five it came from, with every secret redacted.
#
# Naming: every variable starts with DEBATE_, and `__` separates a settings group from a field,
# so `DEBATE_HTTP__MAX_RETRIES` sets `http.max_retries`. Values for list-valued settings are
# JSON.

# --------------------------------------------------------------------------------------------
# Which environment this shell runs against
# --------------------------------------------------------------------------------------------
# One of dev, prod, test. Anything else fails at startup. Unset in a source checkout means dev,
# so that nothing you run by accident touches the production data directory.
DEBATE_ENV=dev

# --------------------------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------------------------
# Root directory for this environment's evidence store, database and exports. The profile for
# each environment sets its own; override it only to point at a scratch directory.
#DEBATE_STORAGE__DATA_DIR=~/.debate-research/dev

# --------------------------------------------------------------------------------------------
# Provider credentials — secrets. These are why this file exists.
# --------------------------------------------------------------------------------------------
# Address sent to OpenAlex and Crossref so they serve requests from their polite pool. Not a
# secret, but it is a real person's email address, so `config show` redacts it like one.
#DEBATE_PROVIDERS__CONTACT_EMAIL=you@example.org

# Semantic Scholar API key, if the account has one.
#DEBATE_PROVIDERS__SEMANTIC_SCHOLAR_API_KEY=

# OpenCaselist session cookie. Obtained by `debate-research caselist auth login`, which writes it
# here for you; it is never printed, logged or committed.
#DEBATE_PROVIDERS__CASELIST_TOKEN=

# Which discovery providers may be called. JSON list; the names are the ones `config show`
# prints under providers.enabled.
#DEBATE_PROVIDERS__ENABLED=["openalex","crossref","rss"]

# --------------------------------------------------------------------------------------------
# HTTP politeness — how the fetcher behaves towards a publisher's server
# --------------------------------------------------------------------------------------------
# Raise the interval, never lower it below what a site asks for. The User-Agent always carries a
# contact URL so a site owner can reach the operator.
#DEBATE_HTTP__PER_HOST_INTERVAL_SECONDS=1.0
#DEBATE_HTTP__REQUEST_TIMEOUT_SECONDS=30.0
#DEBATE_HTTP__CONTACT_URL=https://github.com/charlesclark2/debate-intelligence

# --------------------------------------------------------------------------------------------
# Models
# --------------------------------------------------------------------------------------------
# Task class -> model routing. Validated at startup against the schema in
# debate_core.application.routing_config; see config/model_routing.example.yaml.
#DEBATE_MODELS__ROUTING_FILE=config/model_routing.dev.yaml

# Ceiling on model spend per day, in USD.
#DEBATE_MODELS__BUDGET_USD_DAILY=2.0

# --------------------------------------------------------------------------------------------
# Where profiles are read from
# --------------------------------------------------------------------------------------------
# Only needed outside a source checkout, or when pointing the loader at a fixture directory.
#DEBATE_PROFILE_DIR=config/profiles
