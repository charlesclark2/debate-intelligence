# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
.hypothesis/
htmlcov/
dist/
build/
*.egg-info/

# Node / web
node_modules/
.next/
.turbo/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Debate files at the repository root: real team, caselist and camp files and their
# round-tripped output must never be committed (v1-e31-t01, ADR-0014). Anchored to the root so
# scrubbed fixtures under tests/fixtures/ are unaffected.
/*.docx
/*.doc

# Local data, secrets, OS
.env
.env.*
!.env.example
.data/
*.sqlite
*.sqlite3
.DS_Store
.idea/
.vscode/

# Task workflow scratch (kickoff prompt, PR body)
.task/

# Operator-local Terraform inputs (account ids, emails); never committed. The committed
# per-environment inputs are infrastructure/bootstrap/state/<env>.tfvars and
# infrastructure/envs/<env>/terraform.tfvars, which carry no operator-specific values.
infrastructure/bootstrap/**/terraform.tfvars
infrastructure/**/*.auto.tfvars
!infrastructure/**/*.auto.tfvars.example

# The temporary local backend used for the first apply of infrastructure/bootstrap/state, before
# the bucket it creates exists (docs/runbooks/terraform-bootstrap.md). Never committed: it would
# override the real backend for everyone.
infrastructure/**/backend_override.tf
