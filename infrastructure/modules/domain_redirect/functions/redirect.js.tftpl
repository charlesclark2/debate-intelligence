// CloudFront Function, viewer request: answer every request with a permanent redirect to the
// same path on the canonical host. Terraform template — ${target_host} and
// ${strict_transport_security} are filled in by main.tf, so this file is a .tftpl and not a .js.
//
//   https://wfbdebate.com/parents/faq/?x=1  ->  https://wfbdebate.org/parents/faq/?x=1
//
// The request never reaches an origin, which is why this distribution needs no bucket. The
// Strict-Transport-Security header is set here rather than in a response headers policy, because
// a response generated by a viewer-request function is the one case where it is simplest to be
// certain the header is actually sent.
//
// Written for the cloudfront-js-2.0 runtime without ES6 string helpers: a syntax error here is
// only reported when the function is published, and this function is the entire distribution.

var TARGET_HOST = '${target_host}';
var STRICT_TRANSPORT_SECURITY = '${strict_transport_security}';

function queryString(querystring) {
  var parts = [];
  for (var key in querystring) {
    var parameter = querystring[key];
    if (parameter.multiValue) {
      for (var i = 0; i < parameter.multiValue.length; i++) {
        parts.push(key + '=' + parameter.multiValue[i].value);
      }
    } else if (parameter.value === '') {
      parts.push(key);
    } else {
      parts.push(key + '=' + parameter.value);
    }
  }
  return parts.length === 0 ? '' : '?' + parts.join('&');
}

function handler(event) {
  var request = event.request;

  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: {
      location: {
        value: 'https://' + TARGET_HOST + request.uri + queryString(request.querystring),
      },
      'strict-transport-security': {
        value: STRICT_TRANSPORT_SECURITY,
      },
    },
  };
}
